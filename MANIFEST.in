include LICENSE README.md README.zh-TW.md README.ja.md THIRD_PARTY_NOTICES.md
include run.py example.py
include requirements-dev.txt
recursive-include scripts *.py
recursive-include benchmarks *.py *.json
recursive-include examples *.py
recursive-include greytheory/demos/assets *.png *.json
recursive-include tests *.py *.json
exclude CHANGELOG.md MIGRATION.md IMPLEMENTATION_REPORT.md
exclude LICENSE_AUDIT.md VULNERABILITY_AUDIT.md
exclude sbom.cdx.json sbom.spdx.json runtime-wheel-hashes.json
exclude requirements-runtime-*.lock scripts/audit_runtime.py
prune licenses
prune docs
prune audit
prune test_data
prune tests/fixtures/external
prune artifacts
prune .local
prune test-results
global-exclude *.pyc .DS_Store
